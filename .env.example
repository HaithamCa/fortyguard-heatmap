# Server
PORT=8088

# FortyGuard API (required when DEV_MOCK=false)
FORTYGUARD_API_KEY=your_api_key_here
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Offline demo mode — simulates submit + status without calling FortyGuard
DEV_MOCK=true

# Mock polls before returning completed data (default: 2)
MOCK_POLLS_BEFORE_COMPLETE=2

# Frontend polling (milliseconds)
VITE_POLL_INTERVAL_MS=5000
VITE_POLL_TIMEOUT_MS=300000

# Production frontend → set to deployed backend URL, e.g. https://your-api.railway.app/api
# VITE_API_BASE_URL=/api
